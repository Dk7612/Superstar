{
  "manifest_version": 3,
  "name": "Superstar Mini Window",
  "version": "1.2.6",
  "description": "Superstar's browser companion: a floating star launcher, AI assistant, games, and focus tools. Built for Chrome; also supports Opera GX.",
  "minimum_chrome_version": "103",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://superstar-oa7t.onrender.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Superstar Mini Window"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "global-player.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://superstar-oa7t.onrender.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "update_url": "https://github.com/Dk7612/Superstar/releases/latest/download/updates.xml"
}
